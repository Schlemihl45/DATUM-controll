/* =========================================================
   DATUM Control — Light theme
   Window gradient: #f0f4f8 → #dce4ef  (must stay in sync
   with ThemeManager._THEME_WINDOW_GRADIENT["light"] and the
   Viewport corner-fill shader)
   ========================================================= */

QMainWindow {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 0, y2: 1,
        stop: 0 #f0f4f8,
        stop: 1 #dce4ef
    );
}

/* "Create new tool" popup (tool_list_card.py's CreateToolDialog) — see
   dark.qss's identical rule for why this is needed. */
QDialog#CreateToolDialog {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 0, y2: 1,
        stop: 0 #f0f4f8,
        stop: 1 #dce4ef
    );
}

/* Plain QScrollArea (ToolPage's ToolListView/ToolMagazineBar — the only
   two in the app) has no rule of its own anywhere below, so both its
   frame and its viewport paint Qt's default (opaque) palette background —
   a jarring gray box that doesn't belong on this app's gradient pages.
   Making the scroll area AND its viewport's child widget transparent lets
   the page gradient underneath show through instead, matching every
   other page/Card look. */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Scrollbars — Qt's native ones (used by ToolListView, ToolMagazineBar,
   and ToolCardWidget's horizontal parameter strip) are unstyled/native-
   look by default and clash with the rest of this app; thin, transparent
   track, no arrow buttons, a muted rounded handle that darkens on hover —
   the common modern-minimal scrollbar pattern. */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px 2px 2px 0;
}

QScrollBar::handle:vertical {
    background: rgba(0, 0, 0, 0.18);
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(0, 0, 0, 0.32);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0 2px 2px 2px;
}

QScrollBar::handle:horizontal {
    background: rgba(0, 0, 0, 0.18);
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(0, 0, 0, 0.32);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* --- Card (ui/widgets/card.py) --- */
QFrame#Card {
    background: qradialgradient(
        cx: 0.15, cy: 0.1, radius: 1.1,
        fx: 0.15, fy: 0.1,
        stop: 0 rgba(255, 255, 255, 255),
        stop: 1 rgba(236, 242, 250, 255)
    );
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
}

QLabel#CardTitle {
    color: #4A6080;
    font-size: 12px;
    font-weight: 600;
}

/* Card Button */
QLabel#CardButtonLabel {
    color: #1E2D40;
    font-size: 12px;
    font-weight: 600;
}

QLabel#CardButtonIcon {
    color: #4A6080;
}

/* kleinere Variante für die QuickToolBar unten */
QFrame#Card[variant="quick"] {
    padding: 4px;
}

/* --- StatusBar (ui/widgets/status_bar.py) --- */
QWidget#StatusBar {
    background-color: transparent;
    border-bottom: 1px solid rgba(74, 96, 128, 0.15);
}

QLabel#StatusBarLog {
    color: #4A6080;
    font-size: 12px;
}

QLabel#StatusBarLog[severity="warning"] {
    color: #B06000;
}

QLabel#StatusBarLog[severity="error"] {
    color: #C0292D;
    font-weight: 600;
}

QLabel#StatusBarClock {
    color: #1E2D40;
    font-size: 12px;
    font-family: "Consolas", "Cascadia Mono", monospace;
}

QWidget#machine_info_panel {
    background-color: transparent;
}

QLabel#InfoAxisLetter {
    font-size: 24px;
    color: #4A6080;
}

QLabel#InfoValue {
    font-size: 32px;
    font-weight: bold;
    font-family: "Consolas", "Cascadia Mono", monospace;
    color: #1E2D40;
}

QLabel#InfoUnit {
    font-size: 12px;
    color: #4A6080;
}

QFrame#InfoDivider {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(74, 96, 128, 0),
        stop:0.5 rgba(74, 96, 128, 55),
        stop:1 rgba(74, 96, 128, 0));
    border-radius: 1px;
}

/* Start/Stop/Reset button variants */
QFrame#Card[variant="start"] {
    background: qradialgradient(
        cx: 0.15, cy: 0.1, radius: 1.1,
        fx: 0.15, fy: 0.1,
        stop: 0 #7AC230,
        stop: 1 #4A8A18
    );
}

QFrame#Card[variant="start"]:disabled {
    background: #DCE2EA;
    border: 1px solid rgba(0, 0, 0, 8%);
}

QFrame#Card[variant="stop"] {
    background: qradialgradient(
        cx: 0.15, cy: 0.1, radius: 1.1,
        fx: 0.15, fy: 0.1,
        stop: 0 #E55A60,
        stop: 1 #A02020
    );
}

QFrame#Card[variant="stop"]:disabled {
    background: #DCE2EA;
    border: 1px solid rgba(0, 0, 0, 8%);
}

QFrame#Card[variant="reset"]:disabled {
    background: #DCE2EA;
    border: 1px solid rgba(0, 0, 0, 8%);
}

QFrame#Card[variant="single_block"] {
    background: qradialgradient(
        cx: 0.15, cy: 0.1, radius: 1.1,
        fx: 0.15, fy: 0.1,
        stop: 0 #C8D4E4,
        stop: 1 #9AAFC8
    );
}

QFrame#Card[variant="single_block"][checked="true"] {
    background: qradialgradient(
        cx: 0.15, cy: 0.1, radius: 1.1,
        fx: 0.15, fy: 0.1,
        stop: 0 #4C7FD0,
        stop: 1 #2050A0
    );
    border: 1px solid rgba(80, 120, 200, 0.5);
}

/* Feed Hold — app-wide quick bar (main_window.py). Red as the default
   state, grey once engaged — this bar has no separate Stop button, so
   Feed Hold carries Stop's red warning color itself rather than the amber
   used elsewhere for "engaged" toggles. */
QFrame#Card[variant="feed_hold"] {
    background: qradialgradient(
        cx: 0.15, cy: 0.1, radius: 1.1,
        fx: 0.15, fy: 0.1,
        stop: 0 #E55A60,
        stop: 1 #A02020
    );
}

QFrame#Card[variant="feed_hold"][checked="true"] {
    background: qradialgradient(
        cx: 0.15, cy: 0.1, radius: 1.1,
        fx: 0.15, fy: 0.1,
        stop: 0 #C8D4E4,
        stop: 1 #9AAFC8
    );
    border: 1px solid rgba(150, 165, 185, 0.5);
}

/* G-code viewer */
QPlainTextEdit#GCodeView {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 0, y2: 48,
        stop: 0 #eef2f8,
        stop: 1 #e4eaf4
    );
    border: 1px solid rgba(74, 96, 128, 0.15);
    border-radius: 8px;
    padding: 8px;
    color: #1E2D40;
}

/* Scroll fade overlays */
QWidget#ScrollFadeTop {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(238, 242, 248, 255),
        stop:0.4 rgba(120, 145, 180, 55),
        stop:1 rgba(238, 242, 248, 0));
}

QWidget#ScrollFadeBottom {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(238, 242, 248, 0),
        stop:0.6 rgba(120, 145, 180, 55),
        stop:1 rgba(238, 242, 248, 255));
}

/* Override / settings sliders */
QSlider::groove:horizontal {
    height: 8px;
    background: rgba(0, 0, 0, 0.08);
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: #3A78C0;
    width: 32px;
    height: 32px;
    margin: -12px 0;
    border-radius: 16px;
}

QSlider::handle:horizontal:pressed {
    background: #2060A0;
}

QSlider::sub-page:horizontal {
    background: rgba(58, 120, 192, 0.35);
    border-radius: 4px;
}

/* --- Sim-widget overlay panel (sim/ui/overlay/settings_panel.py) ---
   Card variant so the slide-out strip/panel follows the app theme
   instead of a fixed hard-coded gray. Only the left corners are square
   (right-edge-anchored panel); the strip sits flush against the panel. */
QFrame#Card[variant="sim_overlay"] {
    background: qradialgradient(
        cx: 0.15, cy: 0.1, radius: 1.1,
        fx: 0.15, fy: 0.1,
        stop: 0 rgba(255, 255, 255, 235),
        stop: 1 rgba(236, 242, 250, 235)
    );
    border: 1px solid rgba(0, 0, 0, 0.10);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

/* --- Sim-panel nav buttons (settings_panel.py outer strip, sim_panel.py
   left-hand section nav) — a small checkable icon tile, native look
   instead of the default Qt checked/sunken button style. --- */
QFrame#Card[variant="sim_nav"] {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
}

QFrame#Card[variant="sim_nav"][checked="true"] {
    background: rgba(58, 120, 192, 0.18);
    border: 1px solid rgba(58, 120, 192, 0.4);
}

QComboBox {
    background: rgba(255, 255, 255, 200);
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    padding: 4px 8px;
    color: #1E2D40;
}

QPushButton {
    background: rgba(236, 242, 250, 220);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 4px;
    padding: 6px 12px;
    color: #1E2D40;
}

QPushButton:hover {
    background: rgba(220, 232, 248, 255);
}

QPushButton:pressed {
    background: rgba(200, 216, 240, 255);
}

/* ToolPage: "In Magazine" filter toggle (tool_filter_bar.py) — plain
   QPushButton rather than the Card-based CardButton (Card's hardcoded
   16px margins don't fit a compact, row-height toggle). Base look/hover/
   pressed already come from the generic QPushButton rule above; only the
   checked state is new. */
QPushButton#ToolFilterToggle:checked {
    background: rgba(76, 111, 224, 0.30);
    border: 1px solid rgba(80, 120, 200, 0.6);
    color: #1E2D40;
}

/* ManualPage's JogControlPanel (jog_control_panel.py): step-size button
   (1/0.1/0.01 mm) currently active — same accent-blue "checked" look as
   ToolFilterToggle above, for consistency. NONE checked = continuous jog,
   so this is a plain toggle highlight, not a warning. */
QPushButton#JogStepButton:checked {
    background: rgba(76, 111, 224, 0.30);
    border: 1px solid rgba(80, 120, 200, 0.6);
    color: #1E2D40;
}

/* ManualPage's JogControlPanel: Feed/Rapid toggle — Rapid active is a
   distinct WARNING state (higher jog speed), reusing the same red as the
   Stop control (QFrame#Card[variant="stop"] above) rather than the neutral
   accent-blue toggle color used elsewhere. */
QPushButton#RapidToggle:checked {
    background: #E55A60;
    border: 1px solid #A02020;
    color: #FFFFFF;
}

/* ToolPage: per-card "..." options-menu button (tool_card_widget.py's
   ToolCardWidget header) — plain QToolButton for the same reason (Card's
   margins don't fit a 36px inline icon button). No QToolButton rule
   exists anywhere else, so this is a from-scratch style rather than an
   override. */
QToolButton#ToolMenuButton {
    background: rgba(236, 242, 250, 220);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 4px;
}

QToolButton#ToolMenuButton:hover {
    background: rgba(220, 232, 248, 255);
}

QToolButton#ToolMenuButton:pressed {
    background: rgba(200, 216, 240, 255);
}

/* ToolCardWidget's header options menu (Measure / Set Pocket Number /
   Delete) — sized up (padding + font, iconSize is set in code) for
   better touch targets per explicit request; QMenu has no rule anywhere
   else in the app, so this is a from-scratch style, not an override. */
QMenu {
    background: rgba(255, 255, 255, 250);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 6px;
    padding: 6px;
    icon-size: 22px 22px;
}

QMenu::item {
    padding: 10px 20px;
    border-radius: 4px;
    font-size: 14px;
    color: #1E2D40;
}

QMenu::item:selected {
    background: rgba(76, 111, 224, 0.25);
}

QMenu::separator {
    height: 1px;
    background: rgba(0, 0, 0, 0.10);
    margin: 6px 4px;
}

/* ToolPage: small "#N" pocket-number badge, used both by the magazine
   bar's _PocketSlot and ToolCardWidget's header (tool_magazine_bar.py,
   tool_card_widget.py) — a compact pill, distinct from the plain
   CardButtonLabel text around it. */
QLabel#PocketBadge {
    background: rgba(76, 111, 224, 0.20);
    border: 1px solid rgba(80, 120, 200, 0.5);
    border-radius: 8px;
    padding: 1px 6px;
    color: #26407A;
    font-weight: 600;
    font-size: 11px;
}

/* ToolPage: vertical divider between side-by-side parameter groups in an
   expanded ToolCardWidget's lower body (tool_card_widget.py's _vline()) —
   a plain QFrame with a fixed 1px width needs a background-color here to
   actually render as a visible line; QFrame's own frame-shape styling is
   deliberately not used since it can't be tinted to match the theme. */
QFrame#ParamSeparator {
    background-color: rgba(0, 0, 0, 0.10);
    border: none;
}

/* ToolPage: small muted symbol+unit caption row in a ParamGroup cluster
   (tool_param_group.py) — e.g. "⌀ mm", sits between the group's category
   title and its input field. */
QLabel#ParamUnitLabel {
    color: rgba(0, 0, 0, 0.45);
    font-size: 11px;
}

/* ToolPage: "Create new tool" card (tool_list_card.py's _CreateToolCard) —
   a CardButton variant, dashed border to read as an add-affordance rather
   than a normal tool entry. */
QFrame#Card[variant="create_tool"] {
    border: 1px dashed rgba(80, 120, 200, 0.6);
    background: rgba(76, 111, 224, 0.06);
}

QFrame#Card[variant="create_tool"]:hover {
    background: rgba(76, 111, 224, 0.12);
    border-color: rgba(60, 100, 190, 0.8);
}

/* ToolPage: expanded ToolCardWidget (dynamic "expanded" property toggled
   in set_expanded()) — a subtle accent border marks which card is
   currently open, without changing the base Card look everywhere else. */
QFrame#Card[expanded="true"] {
    border: 1px solid rgba(80, 120, 200, 0.6);
}

/* ui/widgets/tool_usage_card.py's ToolUsageCard toggles this "variant" to
   "in_magazine" whenever the tool currently sits in a magazine pocket —
   the exact same colours as [variant="start"] above, reused deliberately.
   See dark.qss for the full rationale. */
QFrame#Card[variant="in_magazine"] {
    background: qradialgradient(
        cx: 0.15, cy: 0.1, radius: 1.1,
        fx: 0.15, fy: 0.1,
        stop: 0 #7AC230,
        stop: 1 #4A8A18
    );
}

/* WorkpieceDetailPage: an operation card whose G-code file is missing on
   disk — see dark.qss for the same rule. */
QFrame#Card[file_missing="true"] {
    border: 1px solid rgba(180, 120, 0, 0.7);
}

/* ProgramDetailPage: banner shown when viewing a superseded operation
   version — see dark.qss for the same rule. */
QLabel#DeprecatedBanner {
    background: rgba(180, 120, 0, 0.14);
    color: #8A5A00;
    border: 1px solid rgba(180, 120, 0, 0.5);
    border-radius: 6px;
    padding: 6px 10px;
    font-weight: 600;
}

/* ToolCardTitle/ToolCardButtonLabel (tool_card_widget.py's collapsed
   header, reused by program_detail_page.py's _ToolRow) previously had no
   light-theme rule at all here — they silently fell back to Qt's default
   label styling under the light theme. Added for parity with dark.qss. */
QLabel#ToolCardTitle {
    font-family: "Helvetica";
    font-size: 12px;
    color: #4A6080;
}

QLabel#ToolCardButtonLabel {
    font-family: "Helvetica";
    font-size: 16px;
    color: #1E2D40;
    font-weight: bold;
}

/* Workpiece/Operation/History cards — see dark.qss's identical rule for
   why these are their own classes (name big+bold, info small+regular). */
QLabel#WorkpieceCardName {
    font-family: "Helvetica";
    font-size: 17px;
    font-weight: 700;
    color: #1E2D40;
}

QLabel#WorkpieceCardInfo {
    font-family: "Helvetica";
    font-size: 11px;
    font-weight: 400;
    color: #4A6080;
}
